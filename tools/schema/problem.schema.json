{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lemma.problem/1",
  "title": "Lemma 問題（正規データ）",
  "type": "object",
  "required": [
    "id",
    "schema",
    "kind",
    "field",
    "level",
    "statement",
    "answer",
    "solutions",
    "methods",
    "tags",
    "provenance",
    "quality"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^([A-Z]+-[A-Z]+-\\d{3,}|q\\d+)$",
      "description": "変えない・再利用しない。q+数字は内蔵問題用"
    },
    "schema": {
      "const": "lemma.problem/1"
    },
    "kind": {
      "enum": [
        "written",
        "interactive"
      ],
      "description": "written=管理表の記述・入力採点、interactive=内蔵（選択肢・描画など）"
    },
    "field": {
      "type": "string",
      "pattern": "^(I|A|II|B|III|C|X)-\\d{2}$"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "0=基礎 1=標準 2=2次基礎 3=国立2次 4=難関 5=最難関"
    },
    "minutes": {
      "type": "integer",
      "minimum": 1
    },
    "theme": {
      "type": "string",
      "description": "管理表の「単元・テーマ」そのまま"
    },
    "unit": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "statement": {
      "type": "object",
      "required": [
        "tex"
      ],
      "properties": {
        "tex": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "required": [
        "tex"
      ],
      "properties": {
        "tex": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "idea": {
      "type": "object",
      "required": [
        "tex"
      ],
      "properties": {
        "tex": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "grading": {
      "type": "object",
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "lemma-input/1",
            "builtin/1"
          ]
        },
        "spec": {
          "type": "string",
          "description": "lemma-input/1 の入力用の答え（answer.js の parseSpec が読む）"
        },
        "type": {
          "enum": [
            "num",
            "expr",
            "nums",
            "choice",
            "sketch"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "lemma-input/1"
              }
            }
          },
          "then": {
            "required": [
              "spec"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "builtin/1"
              }
            }
          },
          "then": {
            "required": [
              "type"
            ]
          }
        }
      ]
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "solutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "tex"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(main|alt\\d+|note\\d*)$"
          },
          "kind": {
            "enum": [
              "main",
              "alt",
              "note"
            ]
          },
          "tex": {
            "type": "string"
          }
        }
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assets": {
      "type": "object"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "method": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "rights": {
          "type": "string"
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "status",
        "checks",
        "verified"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "draft",
            "submitted",
            "published",
            "hidden",
            "rejected"
          ]
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "verified": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "figure": {
      "type": "object",
      "required": [
        "mode",
        "exprs"
      ],
      "additionalProperties": false,
      "description": "問題の図（管理表の「図の式」列で手書きしたもの）。無ければ content/figures.json の自動の図を使う",
      "properties": {
        "mode": {
          "enum": [
            "2d",
            "complex",
            "vector",
            "3d"
          ]
        },
        "exprs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 30
        },
        "after": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "true＝答え合わせのあとで見せる、false＝最初から、null＝問題文から判断"
        }
      }
    },
    "value": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "教育的価値（管理表の「教育的価値」列。1=低 2=中 3=高）。無いときは content/values.json の自動判定"
    }
  }
}
